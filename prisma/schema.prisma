generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  TWITTER
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
  REEL
  STORY
}

enum MetricSource {
  CONNECTED
  PUBLIC
  IMPORTED
  CALCULATED
  PREDICTED
  UNAVAILABLE
}

enum AnalyticsPeriod {
  DAY
  WEEK
  MONTH
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  NEW
  VIEWED
  ACTIONED
  DISMISSED
}

enum TrendCategory {
  RISING
  TRENDING
  DECLINING
  NICHE_SPECIFIC
  EMERGING
}

enum AudioTrendStatus {
  RISING
  TRENDING
  DECLINING
  STABLE
}

enum RecommendationStatus {
  NEW
  VIEWED
  ACTIONED
  DISMISSED
  EXPIRED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum CalendarItemStatus {
  IDEA
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
}

enum Role {
  USER
  ASSISTANT
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile              Profile?
  settings             UserSettings?
  platformConnections  PlatformConnection[]
  contentPosts         ContentPost[]
  contentIdeas         ContentIdea[]
  contentPillars       ContentPillar[]
  calendarItems        CalendarItem[]
  aiConversations      AIConversation[]
  weeklyReports        WeeklyReport[]
  notifications        Notification[]
  importJobs           ImportJob[]
  syncJobs             SyncJob[]
  competitors          Competitor[]
  recommendations      Recommendation[]
  profileSnapshots     ProfileSnapshot[]
  contentMetrics       ContentMetric[]
  analyticsSnapshots   AnalyticsSnapshot[]
  contentOpportunities ContentOpportunity[]
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  displayName         String
  bio                 String
  website             String
  niche               String
  subNiche            String
  targetAudience      String
  mainGoal            String
  contentStyle        String
  primaryPlatform     String
  postingFrequency    String
  preferredLanguage   String
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean
  weeklyReport       Boolean
  theme              String   @default("dark")
  simpleMode         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformConnection {
  id             String    @id @default(uuid())
  userId         String
  platform       Platform
  accountId      String
  username       String
  displayName    String?
  profilePicture String?
  accountType    String?
  followersCount Int       @default(0)
  followingCount Int       @default(0)
  mediaCount     Int       @default(0)
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  connectedAt    DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthCredential    OAuthCredential?
  profileSnapshots   ProfileSnapshot[]
  syncJobs           SyncJob[]
  contentPosts       ContentPost[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([userId, platform, accountId])
}

model OAuthCredential {
  id                   String    @id @default(uuid())
  platformConnectionId String    @unique
  accessToken          String
  refreshToken         String?
  tokenType            String?
  expiresAt            DateTime?
  scopes               String[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)
}

model ProfileSnapshot {
  id                   String   @id @default(uuid())
  platformConnectionId String
  userId               String
  snapshotDate         DateTime
  followersCount       Int
  followingCount       Int
  mediaCount           Int
  profileScore         Float?
  healthScore          Float?
  data                 Json
  createdAt            DateTime @default(now())

  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([platformConnectionId, snapshotDate])
}

model ContentPost {
  id                   String    @id @default(uuid())
  userId               String
  platformConnectionId String?
  platform             Platform
  externalId           String?
  permalink            String?
  mediaType            MediaType
  caption              String?
  mediaUrl             String?
  thumbnailUrl         String?
  publishedAt          DateTime?
  isImported           Boolean   @default(false)
  importJobId          String?
  performanceScore     Float?
  topic                String?
  contentPillarId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformConnection PlatformConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: SetNull)
  contentPillar      ContentPillar?      @relation(fields: [contentPillarId], references: [id], onDelete: SetNull)
  metrics            ContentMetric?

  @@unique([platform, externalId])
  @@index([userId, publishedAt])
  @@index([userId, platform])
}

model ContentMetric {
  id               String       @id @default(uuid())
  contentPostId    String       @unique
  userId           String
  likesCount       Int          @default(0)
  commentsCount    Int          @default(0)
  sharesCount      Int          @default(0)
  savesCount       Int          @default(0)
  viewsCount       Int          @default(0)
  reachCount       Int          @default(0)
  impressionsCount Int          @default(0)
  profileVisits    Int          @default(0)
  websiteClicks    Int          @default(0)
  engagementRate   Float?
  source           MetricSource
  syncedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  contentPost ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id                   String          @id @default(uuid())
  userId               String
  platformConnectionId String?
  period               AnalyticsPeriod
  snapshotDate         DateTime
  followersCount       Int
  followerGrowth       Int             @default(0)
  reach                Int             @default(0)
  impressions          Int             @default(0)
  engagementRate       Float           @default(0)
  avgLikes             Float           @default(0)
  avgComments          Float           @default(0)
  avgShares            Float           @default(0)
  avgSaves             Float           @default(0)
  avgViews             Float           @default(0)
  postsPublished       Int             @default(0)
  data                 Json?
  createdAt            DateTime        @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformConnection PlatformConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)

  @@index([userId, period, snapshotDate])
}

model ContentPillar {
  id               String   @id @default(uuid())
  userId           String
  name             String
  targetPercentage Float
  color            String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentPosts ContentPost[]

  @@unique([userId, name])
}

model ContentIdea {
  id                String      @id @default(uuid())
  userId            String
  title             String
  hook              String?
  concept           String
  format            String?
  topic             String?
  goal              String?
  audience          String?
  tone              String?
  caption           String?
  cta               String?
  audioDirection    String?
  estimatedEffort   EffortLevel
  opportunityScore  Float?
  whyItFits         String?
  isSaved           Boolean     @default(false)
  isAddedToCalendar Boolean     @default(false)
  calendarItemId    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isSaved])
}

model ContentOpportunity {
  id                String            @id @default(uuid())
  userId            String
  topic             String
  trendRelevance    Float
  nicheRelevance    Float
  historicalFit     Float
  audienceFit       Float
  contentGap        Float
  competition       Float
  opportunityScore  Float
  recommendedAction String
  reasoning         String?
  status            OpportunityStatus
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, opportunityScore])
}

model Trend {
  id                String        @id @default(uuid())
  topic             String
  category          TrendCategory
  trendScore        Float
  growth            Float?
  competition       Float?
  nicheRelevance    Float?
  recommendedAction String?
  platform          String?
  dataSource        String?
  lastUpdatedAt     DateTime
  createdAt         DateTime      @default(now())

  @@index([category, trendScore])
}

model AudioTrend {
  id             String           @id @default(uuid())
  audioName      String
  artist         String?
  platform       String
  trendStatus    AudioTrendStatus
  growth         Float?
  nicheRelevance Float?
  recommendedUse String?
  dataSource     String?
  lastUpdatedAt  DateTime
  createdAt      DateTime         @default(now())
}

model Competitor {
  id                String    @id @default(uuid())
  userId            String
  platform          Platform
  username          String
  displayName       String?
  profilePicture    String?
  followersCount    Int?
  mediaCount        Int?
  avgEngagementRate Float?
  postingFrequency  String?
  topTopics         String[]
  contentFormats    String[]
  lastAnalyzedAt    DateTime?
  data              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, username])
}

model Recommendation {
  id          String               @id @default(uuid())
  userId      String
  category    String
  title       String
  description String
  evidence    String?
  score       Float
  status      RecommendationStatus
  priority    Priority
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
}

model CalendarItem {
  id            String             @id @default(uuid())
  userId        String
  title         String
  status        CalendarItemStatus
  scheduledFor  DateTime?
  publishedAt   DateTime?
  platform      String?
  format        String?
  topic         String?
  caption       String?
  notes         String?
  contentIdeaId String?
  contentPostId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String?
  context   Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           Role
  content        String
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model WeeklyReport {
  id                  String   @id @default(uuid())
  userId              String
  weekStart           DateTime
  weekEnd             DateTime
  accountHealth       Float?
  followerGrowth      Int?
  topPerformingPostId String?
  whatWorked          String?
  whatChanged         String?
  whatFailed          String?
  biggestOpportunity  String?
  recommendedTopics   String[]
  recommendedFormats  String[]
  nextActions         String[]
  data                Json?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model ImportJob {
  id          String    @id @default(uuid())
  userId      String
  filename    String
  status      JobStatus
  totalRows   Int       @default(0)
  successRows Int       @default(0)
  failedRows  Int       @default(0)
  errors      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncJob {
  id                   String     @id @default(uuid())
  userId               String
  platformConnectionId String
  status               SyncStatus
  syncType             String
  startedAt            DateTime?
  completedAt          DateTime?
  error                String?
  itemsSynced          Int        @default(0)
  createdAt            DateTime   @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
